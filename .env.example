# -----------------------------------------------------------------------------
# Tawseel — environment template
# Copy to `.env` for local development, or add these values to your hosting
# provider's environment settings. Never commit the real `.env` file.
# -----------------------------------------------------------------------------

# Core
APP_ENV=development
SECRET_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATA_DIR=./data
HOST=127.0.0.1
PORT=8080
# Prefix used when an admin leaves the shipment code empty (A-Z/0-9).
SHIPMENT_CODE_PREFIX=TS

# Public site contact details (also editable from /admin/settings)
ADMIN_NAME=مدير الموقع
ADMIN_EMAIL=admin@tawseel.local
ADMIN_PASSWORD=Admin1234!

# Reverse proxy / cookies (set these in production)
TRUST_PROXY=0
SESSION_COOKIE_SECURE=0

# Development safety switches. Production forces these off.
# SEED_DEMO also creates the MCT demo branch and staff@tawseel.local account.
DEV_SHOW_OTP=1
SEED_DEMO=1

# SMS provider: log (development only), twilio, or unifonic
SMS_PROVIDER=log
SMS_SENDER=Tawseel

# Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Unifonic (https://unifonic.com)
UNIFONIC_APPSID=
UNIFONIC_SENDER=
UNIFONIC_URL=https://el.cloud.unifonic.com/rest/SMS/messages

# OTP behaviour
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_RESENDS=3
OTP_RATE_LIMIT=6
DEFAULT_COUNTRY_CODE=968

# Optional: send an SMS whenever an admin changes a shipment status
SEND_STATUS_SMS=0
